# ---------------------------------------------------------------
# 复制本文件为 app/.env（或项目根目录 .env）后填写真实值。
# .env 已被 .gitignore 忽略，不会进入仓库。
# 也可以不建 .env，直接在系统里设置同名环境变量。
# ---------------------------------------------------------------

# 模型服务（默认 DeepSeek，可换成任意兼容 OpenAI 协议的服务）
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_VISION_MODEL=deepseek-flash
AI_TIMEOUT_MS=120000

# 必填：在此填入你自己的 API Key（切勿提交到仓库）
AI_API_KEY=

# 监听设置：0.0.0.0 表示允许外部访问；仅本机用 127.0.0.1
HOST=0.0.0.0
PORT=8899

# 可选：部署在公网并绑定域名/反向代理时填写，启动脚本会优先显示它
PUBLIC_URL=
